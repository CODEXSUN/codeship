{
  "name": "@workspace/codeship",
  "version": "1.0.22",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "node --watch src/api/server.ts",
    "start": "node src/api/server.ts",
    "preflight": "node scripts/preflight.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts tools/*.test.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:versions",
    "github:now": "node tools/github-helper.mjs",
    "github:audit": "node tools/github-helper.mjs --dry-run",
    "github:ssh-key": "node tools/github-ssh-key.mjs",
    "version:show": "node tools/check-versions.mjs",
    "version:update": "node tools/version-bump.mjs",
    "version:bump": "node tools/version-bump.mjs",
    "version:preview": "node tools/version-bump.mjs --dry-run",
    "check:versions": "node tools/check-versions.mjs",
    "db:migrate": "node scripts/database.ts migrate",
    "db:status": "node scripts/database.ts status",
    "db:seed": "node scripts/database.ts seed",
    "deploy:setup": "node .container/run-script.mjs setup",
    "deploy:update": "node .container/run-script.mjs update",
    "deploy:verify": "node .container/run-script.mjs verify",
    "metrics:collect": "node scripts/collect-docker-metrics.ts --once",
    "metrics:watch": "node scripts/collect-docker-metrics.ts --watch",
    "infra:group": "node scripts/group-infrastructure.ts",
    "infra:deploy": "node scripts/deploy-infrastructure.ts",
    "infra:generate": "node scripts/generate-infrastructure.ts",
    "db:backup": "node scripts/backup.ts",
    "vault:init": "node scripts/initialize-vault.ts",
    "inventory:import": "node scripts/inventory.ts",
    "dev:api": "node --watch src/api/server.ts",
    "dev:web": "vite"
  },
  "dependencies": {
    "@workspace/framework": "file:../../foundation/framework",
    "@workspace/ui": "file:../../packages/ui",
    "bcryptjs": "3.0.3",
    "kysely": "0.29.9",
    "lucide-react": "1.73.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@workspace/sdk": "file:../../packages/sdk"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
